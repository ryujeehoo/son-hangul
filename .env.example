# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 마세요(.gitignore 에 막혀 있음).

# https://build.nvidia.com 에서 모델 하나 고르고 "Get API Key" 를 누르면 나옵니다.
NVIDIA_API_KEY=nvapi-여기에_본인_키

# 문장 생성에 쓸 모델 (build.nvidia.com 카탈로그의 이름 그대로)
SON_LLM_MODEL=meta/llama-3.3-70b-instruct

# OpenAI 호환 엔드포인트라면 바꿔 끼울 수 있음
# SON_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# 폰트를 내려받을 폴더 (기본: 저장소의 fonts/_downloads)
# SON_FONT_DIR=
